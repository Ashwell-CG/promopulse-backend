<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics - PromoPulse</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('navbar') %>
    <div class="container mt-4">
        <h2 class="mb-4">Analytics</h2>
        
        <div class="row mb-5">
            <div class="col-md-3">
                <div class="stat-card blue">
                    <h2><%= typeof totalCampaigns !== 'undefined' ? totalCampaigns : 0 %></h2>
                    <div class="text-muted small text-uppercase fw-bold">Total Campaigns</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card green">
                    <h2><%= typeof totalCoupons !== 'undefined' ? totalCoupons : 0 %></h2>
                    <div class="text-muted small text-uppercase fw-bold">Total Coupons</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card orange">
                    <h2><%= typeof redeemedCoupons !== 'undefined' ? redeemedCoupons : 0 %></h2>
                    <div class="text-muted small text-uppercase fw-bold">Redeemed Coupons</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card purple">
                    <h2><%= typeof redemptionRate !== 'undefined' ? redemptionRate : 0 %>%</h2>
                    <div class="text-muted small text-uppercase fw-bold">Redemption Rate</div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mx-auto">
                <div class="card">
                    <div class="card-header bg-white fw-bold">
                        Coupon Redemption
                    </div>
                    <div class="card-body">
                        <% if (typeof totalCoupons !== 'undefined' && totalCoupons > 0) { %>
                            <div style="max-width: 400px; margin: auto;">
                                <canvas id="redemptionChart"></canvas>
                            </div>
                        <% } else { %>
                            <p class="text-center text-muted my-5">No coupons yet</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <% if (typeof totalCoupons !== 'undefined' && totalCoupons > 0) { %>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('redemptionChart').getContext('2d');
            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['Redeemed', 'Remaining'],
                    datasets: [{
                        data: [<%= typeof redeemedCoupons !== 'undefined' ? redeemedCoupons : 0 %>, <%= typeof remainingCoupons !== 'undefined' ? remainingCoupons : (totalCoupons - (typeof redeemedCoupons !== 'undefined' ? redeemedCoupons : 0)) %>],
                        backgroundColor: ['#e74c3c', '#2ecc71']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        });
    </script>
    <% } %>
</body>
</html>
