<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campaign Form - PromoPulse</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('navbar') %>
    <div class="container mt-4">
        <% const isEdit = (typeof campaign !== 'undefined' && campaign && campaign._id); %>
        <div class="col-md-8 mx-auto">
            <h2 class="mb-4"><%= isEdit ? 'Edit Campaign' : 'Create Campaign' %></h2>
            
            <div class="card">
                <div class="card-body">
                    <form action="<%= isEdit ? '/campaigns/edit/' + campaign._id : '/campaigns' %>" method="POST">
                        <div class="mb-3">
                            <label for="name" class="form-label">Campaign Name</label>
                            <input type="text" class="form-control" id="name" name="name" value="<%= isEdit ? campaign.name : '' %>" required>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="startDate" class="form-label">Start Date</label>
                                <input type="date" class="form-control" id="startDate" name="startDate" value="<%= isEdit && campaign.startDate ? new Date(campaign.startDate).toISOString().split('T')[0] : '' %>" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="endDate" class="form-label">End Date</label>
                                <input type="date" class="form-control" id="endDate" name="endDate" value="<%= isEdit && campaign.endDate ? new Date(campaign.endDate).toISOString().split('T')[0] : '' %>" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="discountPercentage" class="form-label">Discount Percentage</label>
                            <input type="number" class="form-control" id="discountPercentage" name="discountPercentage" min="1" max="100" value="<%= isEdit ? campaign.discountPercentage : '' %>" required>
                        </div>
                        
                        <div class="mb-4">
                            <label for="status" class="form-label">Status</label>
                            <select class="form-select" id="status" name="status">
                                <option value="Active" <%= isEdit && campaign.status === 'Active' ? 'selected' : '' %>>Active</option>
                                <option value="Inactive" <%= isEdit && campaign.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary"><%= isEdit ? 'Update Campaign' : 'Create Campaign' %></button>
                            <a href="/campaigns" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
