<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - PromoPulse</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('navbar') %>
    <div class="container mt-4">
        <h2 class="mb-4">Dashboard</h2>
        
        <div class="row mb-5">
            <div class="col-md-3">
                <div class="stat-card blue">
                    <h2><%= typeof totalCampaigns !== 'undefined' ? totalCampaigns : 0 %></h2>
                    <div class="text-muted small text-uppercase fw-bold">Total Campaigns</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card green">
                    <h2><%= typeof totalCoupons !== 'undefined' ? totalCoupons : 0 %></h2>
                    <div class="text-muted small text-uppercase fw-bold">Total Coupons</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card orange">
                    <h2><%= typeof redeemedCoupons !== 'undefined' ? redeemedCoupons : 0 %></h2>
                    <div class="text-muted small text-uppercase fw-bold">Redeemed Coupons</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card purple">
                    <h2><%= typeof redemptionRate !== 'undefined' ? redemptionRate : 0 %>%</h2>
                    <div class="text-muted small text-uppercase fw-bold">Redemption Rate</div>
                </div>
            </div>
        </div>

        <h4 class="mb-3">Recent Campaigns</h4>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Campaign Name</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Discount %</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof recentCampaigns !== 'undefined' && recentCampaigns.length > 0) { %>
                                <% recentCampaigns.forEach(campaign => { %>
                                    <tr>
                                        <td><%= campaign.name %></td>
                                        <td><%= new Date(campaign.startDate).toLocaleDateString() %></td>
                                        <td><%= new Date(campaign.endDate).toLocaleDateString() %></td>
                                        <td><%= campaign.discountPercentage %>%</td>
                                        <td>
                                            <span class="badge <%= campaign.status === 'Active' ? 'bg-success' : 'bg-secondary' %>">
                                                <%= campaign.status %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        No campaigns yet. <a href="/campaigns/new">Create one!</a>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
