<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Campaigns - PromoPulse</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('navbar') %>
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">My Campaigns</h2>
            <a href="/campaigns/new" class="btn btn-primary">Create Campaign</a>
        </div>
        
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Discount %</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof campaigns !== 'undefined' && campaigns.length > 0) { %>
                                <% campaigns.forEach(campaign => { %>
                                    <tr>
                                        <td><%= campaign.name %></td>
                                        <td><%= new Date(campaign.startDate).toLocaleDateString() %></td>
                                        <td><%= new Date(campaign.endDate).toLocaleDateString() %></td>
                                        <td><%= campaign.discountPercentage %>%</td>
                                        <td>
                                            <span class="badge <%= campaign.status === 'Active' ? 'bg-success' : 'bg-secondary' %>">
                                                <%= campaign.status %>
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="/campaigns/edit/<%= campaign._id %>" class="btn btn-sm btn-warning">Edit</a>
                                                <form action="/coupons/generate/<%= campaign._id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-info text-white">Generate Coupon</button>
                                                </form>
                                                <form action="/campaigns/delete/<%= campaign._id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        No campaigns yet.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
